{
  "version": 1,
  "web": {
    "enable_fetch": true
  },
  "step1": {
    "search_tier1_min_raw_urls": 15,
    "max_cost_rub": 40,
    "web_search_context_size": "low",
    "web_search_context_size_supplement": "low",
    "tier_max_web_search_batches": 12,
    "min_urls_before_proxyapi": 5,
    "web_search_prefer_alt_providers": false,
    "batch_size": 14,
    "search_fetch_limit": 64,
    "urls_checked_per_collect": 48,
    "soft_time_limit_sec": 200,
    "hard_time_limit_sec": 300,
    "max_candidates_for_ui": 15,
    "verify_workers": 8,
    "crew_fallback_only_if_empty": false,
    "tier_strict_search": true,
    "curious_use_serious_tiers": false,
    "telegram_monitor_enabled": true,
    "telegram_monitor_channels": "technokratos,AI_UD",
    "telegram_max_pages": 4,
    "telegram_max_links": 30,
    "telegram_max_digest_posts": 8,
    "telegram_post_text_filter": "",
    "telegram_timeout_sec": 20,
    "telegram_via_proxyapi": false,
    "telegram_direct_fallback": true,
    "telegram_proxyapi_context_size": "low",
    "seed_urls_max": 35,
    "max_pending_per_host": 4
  },
  "step2": {
    "max_cost_rub": 50
  },
  "workflow": {
    "auto_run_step3_after_order": true
  },
  "step4": {
    "enable_image_generation": false
  },
  "logging": {
    "level": "INFO",
    "enable_file": true,
    "file_name": "app.log",
    "max_bytes": 5000000,
    "backup_count": 5
  }
}
