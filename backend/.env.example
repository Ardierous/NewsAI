PROXYAPI_API_KEY=your_key_here
PROXYAPI_BASE_URL=https://openai.api.proxyapi.ru/v1
PROXYAPI_MODEL=openai/gpt-4.1
PROXYAPI_IMAGE_MODEL=openai/gpt-image-1
DATABASE_URL=sqlite:///./digest.db
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Порт Next.js при запуске через `python main.py` (должен совпадать с URL в FRONTEND_ORIGIN для CORS)
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
ENABLE_WEB_FETCH=false

# Веб-поиск новостей через ProxyAPI (OpenAI web_search). Работает при ENABLE_WEB_FETCH=true.
PROXYAPI_WEB_SEARCH_ENABLED=true
PROXYAPI_WEB_SEARCH_MODEL=gpt-4o-mini
PROXYAPI_WEB_SEARCH_PREVIEW_MODEL=gpt-4o-mini-search-preview
PROXYAPI_WEB_SEARCH_CONTEXT_SIZE=medium
# low — для добора и второго запроса tier-1 (дешевле)
PROXYAPI_WEB_SEARCH_CONTEXT_SIZE_SUPPLEMENT=low
# Второй запрос site:ria.ru… только если после основного поиска сырых URL меньше порога
STEP1_SEARCH_TIER1_MIN_RAW_URLS=15

# Опционально: запасной поиск, если ProxyAPI web_search недоступен
# SERPAPI_API_KEY=
# TAVILY_API_KEY=

# Лимиты суммарных списаний ProxyAPI по записям llm_cost_records (₽)
# STEP1_MAX_COST_RUB=50
# Параметры итеративного шага 1 (батчи + timebox)
# STEP1_BATCH_SIZE=20
# STEP1_SOFT_TIME_LIMIT_SEC=180
# STEP1_HARD_TIME_LIMIT_SEC=300
# STEP1_MAX_CANDIDATES_FOR_UI=15
# STEP1_VERIFY_WORKERS=6
# STEP1_SEARCH_FETCH_LIMIT=100
# STEP1_URLS_CHECKED_PER_COLLECT=80
# STEP1_CREW_FALLBACK_ONLY_IF_EMPTY=true

# Мониторинг Telegram (t.me/s/): внешние ссылки из постов → шаг 1 (не сами посты TG)
# STEP1_TELEGRAM_MONITOR_ENABLED=true
# STEP1_TELEGRAM_MONITOR_CHANNELS=technokratos
# STEP1_TELEGRAM_MAX_PAGES=2
# STEP1_TELEGRAM_MAX_LINKS=30
# STEP1_SEED_URLS_MAX=35
# STEP2_MAX_COST_RUB=50
# AUTO_RUN_STEP3_AFTER_ORDER=true

# Обложки на шаге 4 (4 варианта через ProxyAPI Images). По умолчанию выключено.
# ENABLE_STEP4_IMAGE_GENERATION=true

LOG_LEVEL=INFO
LOG_ENABLE_FILE=true
LOG_FILE_NAME=app.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
