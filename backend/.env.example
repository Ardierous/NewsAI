# Минимальный .env: только секрет. Остальное — config.py + backend/app/pipeline_settings.json
PROXYAPI_API_KEY=your_key_here

# Опционально (обычно не нужно):
# PROXYAPI_BASE_URL=https://openai.api.proxyapi.ru/v1
# PROXYAPI_MODEL=openai/gpt-4.1-mini
#
# SerpAPI / Tavily — альтернативный веб-поиск URL (см. pipeline_settings.json → step1.web_search_prefer_alt_providers).
# Регистрация: serpapi.com, tavily.com — оплата отдельно от ProxyAPI.
# SERPAPI_API_KEY=
# TAVILY_API_KEY=
# В pipeline_settings.json: "web_search_prefer_alt_providers": true — сначала SerpAPI/Tavily, затем ProxyAPI.
# ENABLE_WEB_FETCH=true
# STEP1_HARD_TIME_LIMIT_SEC=900
